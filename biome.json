{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "files": {
    "includes": [
      "**",
      "!**/*.jsonl",
      "!**/.venv",
      "!**/__pycache__",
      "!**/coverage",
      "!**/dist",
      "!**/node_modules",
      "!**/.claude",
      "!**/packages/**/*/spec",
      "!**/python",
      "!**/spec/**/*.json",
      "!scripts/site"
    ]
  }
}
