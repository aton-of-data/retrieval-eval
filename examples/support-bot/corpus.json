{
  "corpus_fingerprint": "recursive/512/64",
  "chunker_fingerprint": "recursive/512/64",
  "chunks": [
    {
      "chunk_id": "c1:7df38ec6d5c5280cd3ff56778da125ef",
      "doc_uri": "help://billing/invoices",
      "doc_revision": "2026-08-04",
      "ordinal": 0,
      "text": "Invoices are issued on the first business day of each month and charged to the payment method on file.",
      "text_sha": "t1:ef9407571be95f23186b2b4319540abc"
    },
    {
      "chunk_id": "c1:e2c4c6f69f38e4ae45d437be12e5c439",
      "doc_uri": "help://billing/invoices",
      "doc_revision": "2026-08-04",
      "ordinal": 1,
      "text": "A failed payment is retried three times over six days before the subscription is suspended.",
      "text_sha": "t1:5b2d8b8db116f672bedb202640a465bf"
    },
    {
      "chunk_id": "c1:f5772a2b45b81d5d0cadf419c3a0f92d",
      "doc_uri": "help://billing/refunds",
      "doc_revision": "2026-08-04",
      "ordinal": 0,
      "text": "Annual plans may be refunded within 30 days of renewal, prorated to the day of the request.",
      "text_sha": "t1:17ca5a0c159688082bbc8c5e50457d23"
    },
    {
      "chunk_id": "c1:7f5f7b88b53fea8116dd359759367eac",
      "doc_uri": "help://billing/refunds",
      "doc_revision": "2026-08-04",
      "ordinal": 1,
      "text": "Monthly plans are not refundable after the billing date, but you can cancel to stop the next charge.",
      "text_sha": "t1:2509bb7ea5654ec9d83fdffd442a2e89"
    },
    {
      "chunk_id": "c1:54130ce877f726b3011378d1a29305f0",
      "doc_uri": "help://shipping/delivery",
      "doc_revision": "2026-07-19",
      "ordinal": 0,
      "text": "Standard delivery takes three to five business days once the order leaves the warehouse.",
      "text_sha": "t1:da43e17b88ca97caa3a5287fefb247b4"
    },
    {
      "chunk_id": "c1:48d45cb90ccb0e5a65d4382f303e001e",
      "doc_uri": "help://shipping/delivery",
      "doc_revision": "2026-07-19",
      "ordinal": 1,
      "text": "Express delivery arrives the next business day for orders placed before 2pm local time.",
      "text_sha": "t1:509deb2cb08701f7bdeccd472934124f"
    },
    {
      "chunk_id": "c1:84a59f357a53889d1c0a6815c09dbe84",
      "doc_uri": "help://shipping/returns",
      "doc_revision": "2026-07-19",
      "ordinal": 0,
      "text": "Unopened items can be returned within 45 days using the prepaid label in the box.",
      "text_sha": "t1:cab80f36be803b0037f527d068489626"
    },
    {
      "chunk_id": "c1:e1f62b47b1124bae32ce9bcfe652137d",
      "doc_uri": "help://shipping/returns",
      "doc_revision": "2026-07-19",
      "ordinal": 1,
      "text": "Return shipping is free for exchanges and deducted from the refund otherwise.",
      "text_sha": "t1:548e6e627f4bc8d11b95739f1813fb79"
    },
    {
      "chunk_id": "c1:8d69dbfa9ba9babb6a0dd33e2a096095",
      "doc_uri": "help://legal/terms",
      "doc_revision": "2026-09-01",
      "ordinal": 0,
      "text": "Disputes are resolved by binding arbitration in the customer's country of residence.",
      "text_sha": "t1:70f41dab2916e01a8a56c90778a89da4"
    },
    {
      "chunk_id": "c1:6d72e3b0121fb6eed6f283b258f5afa2",
      "doc_uri": "help://legal/terms",
      "doc_revision": "2026-09-01",
      "ordinal": 1,
      "text": "Either party may terminate the agreement with 30 days of written notice.",
      "text_sha": "t1:7d8cf374a9748fe46c852543fb2b1ef6"
    },
    {
      "chunk_id": "c1:04223e70378b329a848102a444b4181a",
      "doc_uri": "help://legal/privacy",
      "doc_revision": "2026-09-01",
      "ordinal": 0,
      "text": "Personal data is retained for 24 months after the last account activity, then deleted.",
      "text_sha": "t1:6b56840ee60ad7660d98335537054f86"
    },
    {
      "chunk_id": "c1:8a1da9c4acf280bd67ac57b7107d911e",
      "doc_uri": "help://legal/privacy",
      "doc_revision": "2026-09-01",
      "ordinal": 1,
      "text": "A data export can be requested at any time and is delivered within 30 days.",
      "text_sha": "t1:96dacb2065853c11c6067bb60682af84"
    },
    {
      "chunk_id": "c1:f44f96f1250f7fbcad9c60d42a8f02e3",
      "doc_uri": "help://account/access",
      "doc_revision": "2026-06-11",
      "ordinal": 0,
      "text": "Passwords can be reset from the sign-in page using the email address on the account.",
      "text_sha": "t1:ca2ff2fa0111086daae509ea61e3a2dc"
    },
    {
      "chunk_id": "c1:85a7d970937a0c0258d6186f3820402c",
      "doc_uri": "help://account/access",
      "doc_revision": "2026-06-11",
      "ordinal": 1,
      "text": "Two-factor authentication can be enabled per user and is required for admin roles.",
      "text_sha": "t1:353bda356fa8738f958c126e96ca6928"
    }
  ]
}
