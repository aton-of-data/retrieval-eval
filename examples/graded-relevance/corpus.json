  "chunks": [
    {
      "chunk_id": "c1:47d7ee88f477146832bf98f97595340b",
      "doc_uri": "docs://checkout/idempotency",
      "doc_revision": "v4",
      "ordinal": 0,
      "text": "Send an Idempotency-Key header on every POST so a retry cannot charge a customer twice.",
      "text_sha": "t1:26c0f696a7a7333c6357167fb97b8f66"
    },
    {
      "chunk_id": "c1:1ecc539d4a666501fb10e2b0352d557f",
      "doc_uri": "docs://checkout/idempotency",
      "doc_revision": "v4",
      "ordinal": 1,
      "text": "Keys are stored for 24 hours; a repeat within that window returns the original response.",
      "text_sha": "t1:f781a6d0cc62468e947dbd01b8cdf844"
    },
    {
      "chunk_id": "c1:7a9c6d2b24e1a9ae22339ff24e17c023",
      "doc_uri": "docs://checkout/webhooks",
      "doc_revision": "v4",
      "ordinal": 0,
      "text": "The payment_intent.succeeded event is the only authoritative signal that money moved.",
      "text_sha": "t1:06a1287b40b4591fe4238aeb0d51fe61"
    },
    {
      "chunk_id": "c1:0277e7ac3dfb0c820c7db58a4241e9fb",
      "doc_uri": "docs://checkout/webhooks",
      "doc_revision": "v4",
      "ordinal": 1,
      "text": "Webhook delivery can lag the API response by several seconds under load.",
      "text_sha": "t1:da76f865b6bf4807d7821afdb25e7372"
    },
    {
      "chunk_id": "c1:05ac924c2e2498ac8b5e8bac6965e36b",
      "doc_uri": "docs://checkout/errors",
      "doc_revision": "v4",
      "ordinal": 0,
      "text": "A card_declined error carries a decline_code explaining the issuer's reason.",
      "text_sha": "t1:80e1a68eeb040bd989425edae37204fb"
    },
    {
      "chunk_id": "c1:f60a26e205b2ec3597cbb86aa35636d7",
      "doc_uri": "docs://checkout/errors",
      "doc_revision": "v4",
      "ordinal": 1,
      "text": "Network timeouts should be retried with the same idempotency key, never a new one.",
      "text_sha": "t1:ad88b60bad0a637fd5e45bbe67e57a37"
    },
    {
      "chunk_id": "c1:419c4102ec0dc8edc83daa4c0c933760",
      "doc_uri": "docs://billing/invoices",
      "doc_revision": "v4",
      "ordinal": 0,
      "text": "Invoices move from draft to open to paid, and only open invoices can be voided.",
      "text_sha": "t1:92bd47668d35bef9b73184e930d50abf"
    }
  ]
}
