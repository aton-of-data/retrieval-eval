{
  "name": "retrieval-eval-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "readme": "node scripts/build-readme.mjs",
    "sync:spec": "node scripts/sync-spec.mjs",
    "check:readme": "node scripts/build-readme.mjs --check",
    "check:version": "node scripts/check-version.mjs",
    "check:consistency": "pnpm check:version && pnpm check:readme",
    "release": "pnpm check:consistency && pnpm build && changeset publish",
    "test:coverage": "pnpm -r test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^2.31.1",
    "typescript": "^5.9.3"
  }
}
